<% layout("layouts/boilerplate") %>

    <!-- FILTER BAR -->

    <div class="filters-container">

        <!-- Scroll left -->
        <button class="filter-scroll-btn" id="scrollLeft" type="button" aria-label="Scroll filters left">
            <i class="fa-solid fa-chevron-left"></i>
        </button>

        <!-- Scrollable filters -->
        <div id="filters">

            <div class="filter">
                <i class="fa-solid fa-fire"></i>
                <p>Trending</p>
            </div>

            <div class="filter">
                <i class="fa-solid fa-bed"></i>
                <p>Rooms</p>
            </div>

            <div class="filter">
                <i class="fa-solid fa-panorama"></i>
                <p>Amazing views</p>
            </div>

            <div class="filter">
                <i class="fa-solid fa-monument"></i>
                <p>Iconic cities</p>
            </div>

            <div class="filter">
                <i class="fa-solid fa-umbrella-beach"></i>
                <p>Beach</p>
            </div>

            <div class="filter">
                <i class="fa-solid fa-house-chimney"></i>
                <p>Cabins</p>
            </div>

            <div class="filter">
                <i class="fa-solid fa-dragon"></i>
                <p>OMG!</p>
            </div>

            <div class="filter">
                <i class="fa-solid fa-person-swimming"></i>
                <p>Amazing pools</p>
            </div>

            <div class="filter">
                <i class="fa-solid fa-house-flood-water"></i>
                <p>Lakefronts</p>
            </div>

            <div class="filter">
                <i class="fa-solid fa-mountain-city"></i>
                <p>Mountain cities</p>
            </div>

            <div class="filter">
                <i class="fa-solid fa-igloo"></i>
                <p>Arctic places</p>
            </div>

        </div>

        <!-- Scroll right -->
        <button class="filter-scroll-btn" id="scrollRight" type="button" aria-label="Scroll filters right">
            <i class="fa-solid fa-chevron-right"></i>
        </button>

        <!-- Tax toggle -->
        <div class="tax-toggle">
            <div class="form-check form-switch">

                <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">

                <label class="form-check-label" for="flexSwitchCheckDefault">
                    Display prices including taxes
                </label>

            </div>
        </div>

    </div>

    <!-- LISTING CARDS -->

    <div class="listings-grid">

        <% for (let listing of allListings) { %>

            <div class="card listing-card">

                <img src="<%= listing.image.url %>" class="card-img-top listing-image" alt="<%= listing.title %>"
                    loading="lazy" onclick="openImage('<%= listing.image.url %>')">

                <div class="card-body">

                    <h5 class="card-title">
                        <a href="/listings/<%= listing._id %>">
                            <%= listing.title %>
                        </a>
                    </h5>

                    <p class="card-text">

                        <strong>
                            &#8377;<%= listing.price.toLocaleString("en-IN") %>
                        </strong>

                        <span>/ night</span>

                        <span class="tax-info" style="display: none;">
                            &nbsp;·&nbsp;
                            &#8377;<%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %>
                                including 18% GST
                        </span>

                    </p>

                    <a href="/listings/<%= listing._id %>" class="btn btn-primary">
                        View Details
                    </a>

                </div>

            </div>

            <% } %>

    </div>

    <!-- FILTER SCROLLING & TAX CALCULATION -->

    <script>
        // Horizontal filter scrolling
        const filters = document.getElementById("filters");

        const scrollLeftButton = document.getElementById("scrollLeft");
        const scrollRightButton = document.getElementById("scrollRight");

        scrollLeftButton.addEventListener("click", () => {
            filters.scrollBy({
                left: -250,
                behavior: "smooth"
            });
        });

        scrollRightButton.addEventListener("click", () => {
            filters.scrollBy({
                left: 250,
                behavior: "smooth"
            });
        });

        // Tax-inclusive price display
        const taxSwitch = document.getElementById("flexSwitchCheckDefault");
        const taxInfoElements = document.querySelectorAll(".tax-info");

        function updateTaxDisplay() {
            taxInfoElements.forEach(info => {
                info.style.display = taxSwitch.checked ? "inline" : "none";
            });
        }

        // Set the correct state immediately when the page loads
        updateTaxDisplay();

        // Update prices when the switch is toggled
        taxSwitch.addEventListener("change", updateTaxDisplay);

        // Make category filters functional
        document.querySelectorAll("#filters .filter").forEach(filter => {
            filter.style.cursor = "pointer";

            filter.addEventListener("click", () => {
                const category = filter.querySelector("p").textContent.trim();

                const params = new URLSearchParams(window.location.search);

                params.set("category", category);

                window.location.href = `/listings?${params.toString()}`;
            });
        });
    </script>