<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.css"
        integrity="sha512-x9WwyMYBnlXMNQ6kQ/Lyzu1NqIhLQKL5Oq6xByfXuRj7s9CskyCbLv/1IjqzJmXwFXWr0ov6jBV7Qbc0hh9nHg=="
        crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/starability.css">
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.32.0/mapbox-gl.css" rel="stylesheet">
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.32.0/mapbox-gl.js"></script>
</head>

<body>
    <%- include("../includes/navbar.ejs") %>
        <main class="container">
            <br>
            <%- include("../includes/flash.ejs") %>
                <%- body %>
        </main>
        <!-- IMAGE VIEWER -->
        <div id="imageViewer" class="image-viewer">

            <button class="close-image" onclick="closeImage()">
                &times;
            </button>

            <button class="zoom-btn zoom-out" onclick="zoomOut()">
                −
            </button>

            <img id="fullImage">

            <button class="zoom-btn zoom-in" onclick="zoomIn()">
                +
            </button>

        </div>

        <%- include("../includes/footer.ejs") %>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>
            <script>

                let zoomLevel = 1;

                function openImage(imageUrl) {

                    const viewer = document.getElementById("imageViewer");
                    const image = document.getElementById("fullImage");

                    image.src = imageUrl;

                    zoomLevel = 1;
                    image.style.transform = "scale(1)";

                    viewer.style.display = "flex";
                }


                function closeImage() {

                    const viewer = document.getElementById("imageViewer");

                    viewer.style.display = "none";
                }


                function zoomIn() {

                    const image = document.getElementById("fullImage");

                    zoomLevel += 0.2;

                    image.style.transform = `scale(${zoomLevel})`;
                }


                function zoomOut() {

                    const image = document.getElementById("fullImage");

                    zoomLevel -= 0.2;

                    if (zoomLevel < 1) {
                        zoomLevel = 1;
                    }

                    image.style.transform = `scale(${zoomLevel})`;
                }


                // Close with ESC

                document.addEventListener("keydown", function (event) {

                    if (event.key === "Escape") {
                        closeImage();
                    }

                });


                // Close when clicking the dark background

                document.getElementById("imageViewer").addEventListener("click", function (event) {

                    if (event.target === this) {
                        closeImage();
                    }

                });

            </script>
            <script src="/js/script.js"></script>


</body>

</html>